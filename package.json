{
  "name": "loica-ui-monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/darioegb/loica-ui.git"
  },
  "author": "Dario E Gonzalez B",
  "license": "MIT",
  "version": "0.0.2",
  "scripts": {
    "build": "turbo run build --filter=@loica-ui/docs^...",
    "build:docs": "turbo run build --filter=@loica-ui/docs",
    "dev": "turbo run dev --no-cache --continue --filter=@loica-ui/docs",
    "dev:next": "turbo run dev --continue --filter=loica-ui-next-app...",
    "dev:vite": "turbo run dev --continue --filter=loica-ui-vite-playground...",
    "lint": "turbo run lint --filter=@loica-ui/docs...",
    "lint:fix": "turbo run lint:fix --filter=@loica-ui/docs...",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,mdx}\"",
    "changelog": "node scripts/changelog.js",
    "changelog:commit": "git add CHANGELOG.md && git commit -m 'docs: add changelog' && git push --force origin changelog/main",
    "changeset": "changeset",
    "check:examples": "node scripts/check-examples.mjs",
    "new:component": "node scripts/new-component.mjs",
    "test": "turbo run test --filter=@loica-ui/docs^...",
    "test:coverage": "turbo run test:coverage --filter=@loica-ui/docs^...",
    "test:watch": "turbo run test:watch --filter=@loica-ui/docs^...",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.8",
    "@changesets/cli": "^2.25.2",
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "@storybook/react-vite": "^9.1.20",
    "@types/css-modules": "^1.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^14.0.1",
    "postcss": "^8.4.29",
    "postcss-modules": "^6.0.0",
    "prettier": "^3.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
