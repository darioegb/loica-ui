.__slug__ {
  border-radius: var(--loica-radius-4);
  display: inline-flex;
  font-family: var(--loica-font-family);
}

.sm {
  font-size: var(--loica-font-size-xs);
  padding: var(--loica-space-1) var(--loica-space-2);
}

.md {
  font-size: var(--loica-font-size-sm);
  padding: var(--loica-space-1) var(--loica-space-3);
}

.lg {
  font-size: var(--loica-font-size-lg);
  padding: var(--loica-space-2) var(--loica-space-4);
}

.solid {
  background-color: var(--__slug__-solid);
  color: var(--__slug__-contrast);
}
